: 1, "web": 1, "sitio": 1, "colonia": 1, "san": 1, "benito": 1, "grupo": 1, "tecnologico": 1, "universitario": 1, "parte": 1, "calle": 1, "veracruz": 1, "235": 1, "reforma": 1, "guadalupe": 1, "victoria": 1, "sonora": 1, "c": 1, "p": 1, "83190": 1, "duda": 1, "generale": 1, "escribir": 1, "aparece": 1, "ficha": 1}, "entries": [{"id": "servicios-escolares", "titulo": "Servicios Escolares", "puesto": "Coordinación de Servicios Escolares", "audiencia": ["estudiante"], "categoria": "tramites", "tags": ["inscripcion", "reinscripcion", "credencial", "constancia", "kardex", "historial academico", "baja", "boleta", "documentos", "titulo", "certificado"], "responsable": "Mtra. Laura Pérez (ejemplo)", "correo": "servicios.escolares@ejemplo.edu.mx", "telefono": "662 000 0001 ext. 101", "ubicacion": "Planta baja, a la derecha de la entrada principal, junto a la cafetería", "horario": "Lunes a viernes, 9:00 a 15:00", "web": "", "actualizado": "2026-08-15", "pregunta": "¿Dónde entrego mis documentos de inscripción?", "texto": "Aquí se hacen la inscripción, la reinscripción, las constancias de estudios, el kardex y la baja temporal o definitiva.\nPara inscribirte lleva: identificación oficial, comprobante de pago y acta de nacimiento.\nLa credencial de estudiante se entrega con tu comprobante de inscripción. Puede haber fila los primeros días del semestre."}, {"id": "becas", "titulo": "Becas y Apoyos Económicos", "puesto": "Departamento de Becas", "audiencia": ["estudiante"], "categoria": "tramites", "tags": ["beca", "becas", "apoyo economico", "descuento", "convocatoria", "promedio", "manutencion", "solicitud de beca"], "responsable": "Lic. Carlos Ruiz (ejemplo)", "correo": "becas@ejemplo.edu.mx", "telefono": "662 000 0001 ext. 120", "ubicacion": "Planta baja, pasillo de oficinas administrativas, segunda puerta", "horario": "Lunes a viernes, 10:00 a 14:00", "web": "", "actualizado": "2026-07-01", "pregunta": "¿Cómo solicito una beca?", "texto": "La convocatoria de becas se publica al inicio de cada semestre.\nPara solicitar una beca necesitas: solicitud llena, comprobante de ingresos, constancia con promedio y credencial vigente.\nEl resultado se publica en el tablero de avisos del departamento y por correo institucional."}, {"id": "biblioteca", "titulo": "Biblioteca", "puesto": "Coordinación de Biblioteca", "audiencia": ["todos"], "categoria": "servicios", "tags": ["biblioteca", "libros", "prestamo", "prestamos", "cubiculos", "estudio", "silencio", "credencial", "renovar", "multa", "sala de lectura"], "responsable": "Biblioteca Central (ejemplo)", "correo": "biblioteca@ejemplo.edu.mx", "telefono": "662 000 0001 ext. 140", "ubicacion": "Piso 2, al salir del elevador a la izquierda", "horario": "Lunes a viernes, 8:00 a 20:00; sábados, 9:00 a 13:00", "web": "", "actualizado": "2026-08-20", "pregunta": "¿Cuál es el horario de la biblioteca?", "texto": "Para pedir libros prestados presenta tu credencial vigente. El préstamo es de 7 días y se puede renovar una vez.\nHay cubículos de estudio que se reservan en el mostrador. La sala de lectura es zona de silencio."}, {"id": "soporte-ti", "titulo": "Soporte Técnico y Tecnologías de la Información", "puesto": "Departamento de Tecnologías de la Información", "audiencia": ["todos"], "categoria": "tecnologia", "tags": ["wifi", "internet", "red", "correo institucional", "contraseña", "plataforma", "aula virtual", "cuenta", "proyector", "soporte", "computadora"], "responsable": "Ing. Marco Soto (ejemplo)", "correo": "soporte.ti@ejemplo.edu.mx", "telefono": "662 000 0001 ext. 160", "ubicacion": "Piso 3, cubículo junto a los laboratorios de cómputo", "horario": "Lunes a viernes, 8:00 a 17:00", "web": "", "actualizado": "2026-09-01", "pregunta": "No puedo conectarme al Wi-Fi", "texto": "Para conectarte al Wi-Fi usa la red del campus con tu correo institucional y tu contraseña.\nSi olvidaste tu contraseña, pide el restablecimiento en soporte con tu credencial.\nLos profesores pueden pedir apoyo con proyector y equipo de aula con un día de anticipación."}, {"id": "alta-profesores", "titulo": "Alta y Contratación de Profesores", "puesto": "Coordinación Académica", "audiencia": ["profesor"], "categoria": "tramites", "tags": ["alta", "contratacion", "contrato", "profesor de nuevo ingreso", "docente", "nomina", "expediente", "horario de clases", "cubiculo"], "responsable": "Dra. Ana Torres (ejemplo)", "correo": "coordinacion.academica@ejemplo.edu.mx", "telefono": "662 000 0001 ext. 201", "ubicacion": "Piso 3, oficina al fondo del pasillo principal", "horario": "Lunes a viernes, 9:00 a 16:00", "web": "", "actualizado": "2026-08-10", "pregunta": "¿Qué documentos necesito para mi alta como profesor?", "texto": "Para tu alta como profesor entrega: identificación oficial, comprobante de domicilio, currículum y título o cédula.\nCon el expediente completo se firma el contrato y se asigna tu cubículo y tu horario de clases."}, {"id": "calificaciones-profesores", "titulo": "Captura de Calificaciones y Actas", "puesto": "Coordinación Académica", "audiencia": ["profesor"], "categoria": "tramites", "tags": ["calificaciones", "actas", "captura", "evaluacion", "fechas limite", "lista de asistencia", "asistencia", "plataforma"], "responsable": "Dra. Ana Torres (ejemplo)", "correo": "coordinacion.academica@ejemplo.edu.mx", "telefono": "662 000 0001 ext. 202", "ubicacion": "Piso 3, oficina al fondo del pasillo principal", "horario": "Lunes a viernes, 9:00 a 16:00", "web": "", "actualizado": "2025-01-10", "pregunta": "¿Cómo capturo las calificaciones?", "texto": "Las calificaciones se capturan en la plataforma académica dentro del periodo marcado en el calendario.\nDespués se imprime y firma el acta y se entrega en Coordinación Académica.\nLa asistencia mínima para tener derecho a examen la define el reglamento de evaluación."}, {"id": "servicio-social", "titulo": "Servicio Social", "puesto": "Departamento de Vinculación", "audiencia": ["estudiante"], "categoria": "tramites", "tags": ["servicio social", "practicas profesionales", "liberacion", "horas", "vinculacion", "carta de presentacion"], "responsable": "Lic. Elena Mora (ejemplo)", "correo": "vinculacion@ejemplo.edu.mx", "telefono": "662 000 0001 ext. 130", "ubicacion": "Piso 1, junto a la escalera principal", "horario": "Lunes a viernes, 9:00 a 14:00", "web": "", "actualizado": "2026-06-15", "pregunta": "¿Cómo inicio mi servicio social?", "texto": "Puedes iniciar el servicio social al cubrir el porcentaje de créditos que marca el reglamento.\nPasos: registrar el proyecto, pedir la carta de presentación, cumplir las horas y entregar los reportes para la liberación."}, {"id": "apoyo-psicopedagogico", "titulo": "Apoyo Psicopedagógico e Inclusión", "puesto": "Unidad de Tutorías e Inclusión", "audiencia": ["todos"], "categoria": "apoyo", "tags": ["tutoria", "tutorias", "inclusion", "discapacidad", "autismo", "ajustes razonables", "apoyo", "psicopedagogico", "accesibilidad", "elevador"], "responsable": "Unidad de Tutorías e Inclusión (ejemplo)", "correo": "inclusion@ejemplo.edu.mx", "telefono": "662 000 0001 ext. 150", "ubicacion": "Piso 1, oficina junto al elevador", "horario": "Lunes a viernes, 9:00 a 17:00", "web": "", "actualizado": "2026-08-25", "pregunta": "¿Dónde pido apoyo de tutoría o inclusión?", "texto": "La unidad acompaña a estudiantes y profesores con necesidades de apoyo y coordina ajustes razonables en clase.\nPuedes pedir una cita por correo o acudir directamente. El elevador del edificio está junto a esta oficina.\nEste servicio informa y canaliza; no sustituye atención médica o psicológica especializada."}, {"id": "cafeteria", "titulo": "Cafetería", "puesto": "Concesión de Cafetería", "audiencia": ["todos"], "categoria": "servicios", "tags": ["cafeteria", "comida", "comedor", "desayuno", "cafe", "comer", "menu"], "responsable": "", "correo": "", "telefono": "", "ubicacion": "Planta baja, junto a Servicios Escolares", "horario": "Lunes a viernes, 7:30 a 17:00", "web": "", "actualizado": "2026-08-15", "pregunta": "", "texto": "Hay desayunos y comidas. Se paga en caja al entrar. Puede haber más gente entre 13:00 y 15:00."}, {"id": "gtu-campus-hermosillo", "titulo": "GTU Campus Hermosillo", "puesto": "Grupo Tecnológico Universitario", "audiencia": ["todos"], "categoria": "informacion", "tags": ["direccion", "domicilio", "ubicacion del campus", "donde queda", "como llegar", "telefono", "correo", "contacto", "pagina web", "sitio web", "hermosillo", "colonia san benito", "campus"], "responsable": "", "correo": "vroman.tuc@gmail.com", "telefono": "662 336 6626", "ubicacion": "Calle Veracruz No. 235, Colonia San Benito, entre Calle De La Reforma y Calle Guadalupe Victoria, Hermosillo, Sonora, C.P. 83190", "horario": "", "web": "https://gtuhermosillo.com/", "actualizado": "2026-10-11", "pregunta": "¿Cuál es la dirección del campus?", "texto": "GTU Campus Hermosillo es parte del Grupo Tecnológico Universitario.\nEstá en Calle Veracruz No. 235, Colonia San Benito, entre Calle De La Reforma y Calle Guadalupe Victoria, en Hermosillo, Sonora, C.P. 83190.\nPara dudas generales puedes llamar por teléfono o escribir al correo que aparece en esta ficha."}], "tf": [{"servicio": 5, "escolare": 5, "inscripcion": 6, "reinscripcion": 5, "credencial": 5, "constancia": 5, "kardex": 5, "historial": 4, "academico": 4, "baja": 6, "boleta": 4, "documento": 4, "titulo": 4, "certificado": 4, "coordinacion": 2, "tramite": 2, "aqui": 1, "hacen": 1, "estudio": 1, "temporal": 1, "definitiva": 1, "inscribirte": 1, "lleva": 1, "identificacion": 1, "oficial": 1, "comprobante": 2, "pago": 1, "acta": 1, "nacimiento": 1, "estudiante": 1, "entrega": 1, "haber": 1, "fila": 1, "primero": 1, "dia": 1, "semestre": 1, "planta": 1, "derecha": 1, "entrada": 1, "principal": 1, "junto": 1, "cafeteria": 1, "horario": 1, "hora": 1, "abre": 1, "cierra": 1, "atencion": 1, "ubicacion": 1, "ubicado": 1, "queda": 1, "telefono": 1, "llamar": 1, "contacto": 2, "correo": 1, "email": 1}, {"beca": 19, "apoy