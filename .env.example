# Configuración de COCA-COLA GUÍA (copia a .env para desarrollo local; en Render configúralas en Environment)
LLM_PROVIDER=anthropic
MODEL_NAME=claude-haiku-5-5
LLM_API_KEY=
ADMIN_TOKEN=cambia-este-token-por-uno-aleatorio-de-al-menos-16-caracteres
ID_SALT=cambia-esta-sal-aleatoria
TIMEZONE=America/Hermosillo
SHOW_ADMIN_LINK=true

# Opcional: publicación directa del catálogo en GitHub desde /admin
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_CORPUS_PATH=data/corpus.txt

# Opcional: webhook para recibir informes de preguntas sin respuesta
REPORT_WEBHOOK_URL=
